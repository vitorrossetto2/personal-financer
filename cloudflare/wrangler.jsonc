{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-financer",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "python_workers"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-financer",
      "database_id": "204ac0c5-be35-4b37-afe1-19e72ed14019",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "uv run python ../scripts/prepare_cloudflare.py"
  }
}
