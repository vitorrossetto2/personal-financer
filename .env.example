# Credenciais de um cliente OAuth 2.0 do tipo "Aplicativo da Web" no Google Cloud.
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# Única conta Google que poderá entrar no NovoSaldo.
NOVOSALDO_ALLOWED_EMAIL=seu-email@gmail.com

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
NOVOSALDO_SECRET_KEY=cole-aqui-uma-chave-aleatoria

# Em produção, com acesso exclusivamente por HTTPS, use true.
NOVOSALDO_HTTPS=false

# Dispensa o login somente para acessos feitos neste computador (127.0.0.1/localhost).
NOVOSALDO_LOCAL_AUTH_DISABLED=true

# O MCP fica ativo por padrão apenas quando o servidor escuta no computador local.
# Todas as requisições MCP exigem Authorization: Bearer <NOVOSALDO_MCP_TOKEN>.
# Sem token configurado, o MCP bloqueia o acesso, inclusive local.
# Gere um token aleatório como a chave de sessão acima e mantenha-o privado.
NOVOSALDO_MCP_TOKEN=
# NOVOSALDO_MCP_ENABLED=false
